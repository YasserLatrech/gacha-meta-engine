generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Game {
  id                  String              @id @default(cuid())
  slug                String              @unique
  name                String
  shortName           String
  asianRegion         String              // "JP" | "CN" | "TW" | "KR"
  asianPatchVersion   String
  globalPatchVersion  String
  foresightGapMonths  Float
  coverImageUrl       String
  currencyName        String              // "Quartz" | "Carats" | "Hope Luxites"
  pullCostSingle      Int
  pityThreshold       Int
  monthlyF2pIncome    Int
  monthlyPassIncome   Int
  rolesConfig         Json                // Role column definitions for the 2D Tier Matrix
  elementsConfig      Json                // Element / Type definitions and badge colors
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  units               Unit[]
  equipments          Equipment[]
  banners             BannerSchedule[]
  tierEntries         TierEntry[]
  bossEncounters      BossEncounter[]
  formulas            FormulaDefinition[]
  syncLogs            SyncAuditLog[]
}

model Unit {
  id                  String      @id @default(cuid())
  gameId              String
  game                Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  externalId          String
  slug                String
  nameEn              String
  nameOriginal        String
  styleOrTitle        String
  rarity              String
  role                String      // Maps to Game.rolesConfig column
  element             String
  attackType          String      // e.g. "Slash" | "Pierce" | "Crush" | "Runner" | "Leader"
  imageUrl            String
  releaseDateAsian    DateTime
  releaseDateGlobal   DateTime?
  isReleasedGlobal    Boolean     @default(false)
  longevityMonths     Int
  recommendedDupes    String      // e.g. "LB0 Ready" | "LB1 Core" | "3-Star"
  baseStats           Json        // Verified max-level stats (STR, DEX, END,MND, SPD, STA, POW, etc.)
  skills              Json        // Array of verified skills with exact SP/Energy cost, multipliers, hits, buff tags
  passives            Json        // Limit break / dupe passives (LB0, LB1, LB3, Awakening)
  synergyUnitSlugs    Json        // Recommended partner unit slugs
  sourceUrl           String
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  tierEntries         TierEntry[]

  @@unique([gameId, slug])
  @@index([gameId, role, element])
}

model Equipment {
  id                  String      @id @default(cuid())
  gameId              String
  game                Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  externalId          String
  slug                String
  nameEn              String
  category            String      // "Support Card" | "Weapon" | "Accessory" | "Orb" | "Tarot"
  subType             String      // e.g. "Speed" | "Stamina" | "Sword" | "Bow" | "Charm"
  rarity              String
  imageUrl            String
  tierRank            String      // "SSS" | "SS" | "S" | "A"
  score               Float
  recommendedDupes    String      // e.g. "MLB (4LB)" | "1LB Usable" | "5-Star"
  stats               Json        // Verified stat bonuses
  effectSummary       String
  bestHolderSlugs     Json        // Unit slugs that best use this weapon/card
  sourceUrl           String
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([gameId, slug])
  @@index([gameId, category, tierRank])
}

model TierEntry {
  id                  String      @id @default(cuid())
  gameId              String
  game                Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  unitId              String
  unit                Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  category            String      // "OVERALL" | "REROLL" | "BOSS_RAID"
  serverScope         String      // "ASIAN_FUTURE" | "GLOBAL_CURRENT"
  tierRank            String      // "SSS" | "SS" | "S" | "A"
  roleColumn          String      // "DPS" | "SUB_DPS" | "SUPPORT" | "SUSTAIN"
  numericScore        Float
  summaryVerdict      String
  longevityNote       String
  updatedAt           DateTime    @updatedAt

  @@unique([gameId, unitId, category, serverScope])
  @@index([gameId, category, serverScope, tierRank])
}

model BossEncounter {
  id                  String      @id @default(cuid())
  gameId              String
  game                Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  slug                String
  nameEn              String
  modeName            String      // e.g. "Score Attack #42" | "Anachrony Raid" | "Champions Meet" | "Tower of Conquest"
  difficultyLabel     String
  imageUrl            String
  hpStat              String      // e.g. "12,500,000 HP" or "2400m Turf (Clockwise)"
  shieldOrDpStat      String      // e.g. "480,000 DP" or "Min Stamina: 950 + 2 Gold Recoveries"
  weaknesses          Json        // Array of weakness tags e.g. ["Light (+150%)", "Pierce (+150%)"]
  resistances         Json        // Array of resistance tags e.g. ["Fire (-50%)", "Slash (-50%)"]
  attackPatterns      Json        // Turn-by-turn boss rotation / phase mechanics
  strategySteps       Json        // Step-by-step how-to-beat clear guide
  recommendedUnitSlugs Json       // Counter unit slugs
  sourceUrl           String
  updatedAt           DateTime    @updatedAt

  @@unique([gameId, slug])
}

model BannerSchedule {
  id                  String      @id @default(cuid())
  gameId              String
  game                Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  slug                String
  bannerTitle         String
  bannerType          String      // "LIMITED" | "COLLAB" | "FESTIVAL" | "STANDARD" | "SUPPORT_CARD"
  imageUrl            String
  featuredNames       Json        // Featured unit/card names
  featuredUnitSlugs   Json        // Featured unit slugs
  asianStartDate      DateTime
  asianEndDate        DateTime
  estGlobalStartDate  DateTime
  estGlobalEndDate    DateTime
  pullVerdict         String      // "MUST_PULL" | "HIGH_VALUE" | " NICHE_META" | "EASY_SKIP"
  verdictReasoning    String
  pityCurrencyCost    Int
  sourceUrl           String
  updatedAt           DateTime    @updatedAt

  @@unique([gameId, slug])
  @@index([gameId, estGlobalStartDate])
}

model FormulaDefinition {
  id                  String      @id @default(cuid())
  gameId              String
  game                Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  formulaKey          String
  title               String
  description         String
  parametersSchema    Json
  expressionMeta      Json
  sourceCitation      String
  updatedAt           DateTime    @updatedAt

  @@unique([gameId, formulaKey])
}

model SyncAuditLog {
  id                  String      @id @default(cuid())
  gameId              String
  game                Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  adapterName         String
  sourceUrl           String
  recordsSynced       Int
  validationPassed    Boolean
  checksumHash        String
  executedAt          DateTime    @default(now())
}
