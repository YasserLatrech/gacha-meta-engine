# Neon Serverless PostgreSQL connection string (optional offline; automatically falls back to verified seed data)
DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Canonical public domain used for SEO metadata, JSON-LD, robots.txt, and sitemap.xml
NEXT_PUBLIC_SITE_URL="https://ascalon.fun"

# Minimum 32-char cryptographic random secret required to authorize POST /api/revalidate
REVALIDATE_SECRET=""

# Minimum 32-char cryptographic random HMAC secret for privacy-preserving 1-vote-per-IP & visitor analytics hashing
VOTE_IP_HASH_SECRET=""

# Optional Google Search Console meta tag token & Google Analytics 4 Measurement ID
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_GA4_ID=""

# Optional Adsterra Monetization Slots (leave empty until ready; preview slots anytime with ?adpreview=1)
NEXT_PUBLIC_ADSTERRA_INVOKE_HOST="www.highperformanceformat.com"
NEXT_PUBLIC_ADSTERRA_BANNER_728_KEY=""
NEXT_PUBLIC_ADSTERRA_BANNER_320_KEY=""
NEXT_PUBLIC_ADSTERRA_BANNER_300_KEY=""
NEXT_PUBLIC_ADSTERRA_NATIVE_KEY=""
NEXT_PUBLIC_ADSTERRA_NATIVE_SRC=""
NEXT_PUBLIC_ADSTERRA_SOCIAL_BAR_SRC=""
