# Neon Serverless PostgreSQL connection string (optional offline; automatically falls back to verified seed data)
DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Canonical public domain used for SEO metadata, JSON-LD, robots.txt, and sitemap.xml
NEXT_PUBLIC_SITE_URL="https://ascalon.fun"

# Minimum 32-char cryptographic random secret required to authorize POST /api/revalidate
REVALIDATE_SECRET=""

# Minimum 32-char cryptographic random HMAC secret for privacy-preserving 1-vote-per-IP hashing
VOTE_IP_HASH_SECRET=""
